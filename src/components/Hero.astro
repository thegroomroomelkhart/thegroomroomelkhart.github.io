---
import { site } from "../config/site";
---

<section id="top" class="relative overflow-hidden">
  <!-- soft decorative background -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-sand/70 via-cream to-cream"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:py-28">
    <p
      class="mb-4 inline-block rounded-full bg-sage/15 px-4 py-1 text-sm font-600 text-sage"
    >
      🐾 {site.location}
    </p>
    <h1
      class="mx-auto max-w-3xl text-4xl font-700 leading-tight text-ink sm:text-6xl"
    >
      Happy dogs, <span class="text-brand">beautiful grooms.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-muted">
      {site.tagline}
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`tel:${site.contact.phoneRaw}`}
        class="rounded-full bg-brand px-7 py-3 text-base font-600 text-white shadow-md transition hover:bg-brand-600"
      >
        Book by phone — {site.contact.phone}
      </a>
      <a
        href="#services"
        class="rounded-full border border-ink/15 bg-white/60 px-7 py-3 text-base font-600 text-ink transition hover:border-brand hover:text-brand"
      >
        See services
      </a>
    </div>

    <p class="mt-6 text-sm text-muted">
      Open Tuesday–Saturday · By appointment
    </p>
  </div>
</section>
