---
import { site } from "../config/site";
---

<section id="services" class="bg-white/60 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-700 text-ink sm:text-4xl">Services</h2>
      <p class="mt-4 text-lg text-muted">
        Every groom is tailored to your dog. Call to talk through what your pup
        needs — we're happy to help.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.services.map((service) => (
          <div class="rounded-2xl border border-sand bg-cream p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-xl font-600 text-ink">{service.name}</h3>
              {service.price && (
                <span class="whitespace-nowrap rounded-full bg-sage/15 px-3 py-1 text-sm font-600 text-sage">
                  {service.price}
                </span>
              )}
            </div>
            <p class="mt-3 text-muted">{service.description}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-muted">
      Pricing varies by breed, coat, and condition. Call {site.contact.phone} for
      a quote.
    </p>
  </div>
</section>
