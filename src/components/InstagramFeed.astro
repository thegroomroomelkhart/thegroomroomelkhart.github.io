---
import { site } from "../config/site";

const { beholdFeedUrl, profileUrl, handle, maxPosts } = site.instagram;
const isConfigured = beholdFeedUrl.trim().length > 0;
---

<section id="gallery" class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
  <div
    class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left"
  >
    <div>
      <h2 class="text-3xl font-700 text-ink sm:text-4xl">Latest Grooms</h2>
      <p class="mt-3 text-lg text-muted">
        Fresh from the shop, straight from our Instagram.
      </p>
    </div>
    {
      profileUrl && (
        <a
          href={profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-ink/15 px-5 py-2.5 text-sm font-600 text-ink transition hover:border-brand hover:text-brand"
        >
          Follow {handle || "on Instagram"} ↗
        </a>
      )
    }
  </div>

  <div
    id="ig-grid"
    data-feed-url={beholdFeedUrl}
    data-max={maxPosts}
    class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4"
  >
    {
      isConfigured ? (
        // Skeleton tiles shown while the live feed loads.
        Array.from({ length: 8 }).map(() => (
          <div class="aspect-square animate-pulse rounded-xl bg-sand/70" />
        ))
      ) : (
        // Friendly placeholder until the Instagram account is connected.
        Array.from({ length: 8 }).map((_, i) => (
          <div class="flex aspect-square items-center justify-center rounded-xl bg-sand/60 text-3xl opacity-70">
            {["🐕", "🐩", "🦴", "🐾", "✂️", "🛁", "🐶", "❤️"][i % 8]}
          </div>
        ))
      )
    }
  </div>

  {
    !isConfigured && (
      <p class="mt-6 text-center text-sm text-muted">
        Our live Instagram gallery will appear here once the account is set up.
      </p>
    )
  }
</section>

<script>
  // Live Instagram feed via Behold (https://behold.so). Runs in the browser so
  // the newest posts always show without rebuilding the site.
  type BeholdPost = {
    id?: string;
    permalink?: string;
    mediaType?: string;
    mediaUrl?: string;
    thumbnailUrl?: string;
    caption?: string;
    prunedCaption?: string;
    timestamp?: string;
    sizes?: Record<string, { mediaUrl?: string } | undefined>;
  };

  const grid = document.getElementById("ig-grid");
  const feedUrl = grid?.dataset.feedUrl?.trim();
  const max = Number(grid?.dataset.max || 12);

  if (grid && feedUrl) {
    loadFeed(grid, feedUrl, max).catch(() => showError(grid));
  }

  async function loadFeed(grid: HTMLElement, url: string, max: number) {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`Feed responded ${res.status}`);
    const data = await res.json();

    const posts: BeholdPost[] = Array.isArray(data)
      ? data
      : (data.posts ?? []);

    // Newest first, just in case the feed order ever changes.
    posts.sort(
      (a, b) =>
        new Date(b.timestamp ?? 0).getTime() -
        new Date(a.timestamp ?? 0).getTime(),
    );

    const top = posts.slice(0, max);
    if (top.length === 0) return; // keep the skeletons rather than blank out

    grid.innerHTML = "";
    for (const post of top) {
      grid.appendChild(renderTile(post));
    }
  }

  function pickImage(post: BeholdPost): string {
    if (post.mediaType === "VIDEO" && post.thumbnailUrl) return post.thumbnailUrl;
    return (
      post.sizes?.medium?.mediaUrl ??
      post.sizes?.small?.mediaUrl ??
      post.mediaUrl ??
      post.thumbnailUrl ??
      ""
    );
  }

  function renderTile(post: BeholdPost): HTMLElement {
    const a = document.createElement("a");
    a.href = post.permalink ?? "#";
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    a.className =
      "group relative block aspect-square overflow-hidden rounded-xl bg-sand/70";

    const img = document.createElement("img");
    img.src = pickImage(post);
    img.alt = post.prunedCaption ?? post.caption ?? "Instagram photo";
    img.loading = "lazy";
    img.className =
      "h-full w-full object-cover transition duration-300 group-hover:scale-105";
    a.appendChild(img);

    if (post.mediaType === "VIDEO" || post.mediaType === "CAROUSEL_ALBUM") {
      const badge = document.createElement("span");
      badge.className =
        "absolute right-2 top-2 rounded-full bg-black/55 px-1.5 py-0.5 text-xs text-white";
      badge.textContent = post.mediaType === "VIDEO" ? "▶" : "❏";
      a.appendChild(badge);
    }

    return a;
  }

  function showError(grid: HTMLElement) {
    grid.innerHTML =
      '<p class="col-span-full text-center text-sm text-muted">Couldn\'t load the gallery right now. Please check back soon.</p>';
  }
</script>
